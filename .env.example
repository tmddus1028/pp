LLM_PROVIDER=local
# Explicit AI/revision buttons only: inherit/local/local_ollama/anthropic/openai/azure/qwen.
# Team default: local Ollama now, Claude API (anthropic) once a key is issued.
IMPROVEMENT_PROVIDER=local_ollama
# Claude API (Anthropic). Blank key → SDK falls back to ANTHROPIC_API_KEY env / `ant auth login`.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
# Hosted Qwen review only. Copy the compatible-mode/v1 HTTPS base URL from your
# Model Studio region/workspace. Choose a model supporting strict JSON Schema.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
# json_object: all Model Studio text models (schema travels in the prompt).
# json_schema: strict schema, only on models that support it.
QWEN_RESPONSE_FORMAT=json_object
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# Installed model from `ollama list`, e.g. qwen3:14b (better) or qwen3:8b (faster).
LOCAL_LLM_MODEL=qwen3:14b
LOCAL_LLM_TIMEOUT_SECONDS=600
# qwen3 reasoning: false keeps responses fast and JSON-only.
LOCAL_LLM_THINK=false
LOCAL_LLM_CONTEXT_TOKENS=40960
LOCAL_LLM_MAX_OUTPUT_TOKENS=12000
# Re-ask once when a draft fails an evidence gate.
IMPROVEMENT_REPAIR_ATTEMPTS=1
# true: show the items that pass every gate and say how many were hidden (default: hide all).
IMPROVEMENT_PRUNE_INVALID=false
# Optional, already installed Ollama embedding model. Never auto-downloads.
LOCAL_EMBEDDING_MODEL=
# Set a Structured Outputs-capable model explicitly for your account.
OPENAI_API_KEY=
OPENAI_MODEL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
LLM_TIMEOUT_SECONDS=300
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=150
MAX_DOCUMENT_CHARS=500000
OA_CHUNK_CHARS=14000
API_BASE_URL=http://127.0.0.1:8000
# Local OCR only. Blank command: PATH or standard Windows install locations.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_DPI=300
OCR_MIN_TEXT_CHARS=20
OCR_TIMEOUT_SECONDS=60
OCR_MAX_PIXELS=40000000
# auto: prefer PyMuPDF; PDFium only if PyMuPDF cannot load. pymupdf: strict mode.
OCR_RENDERER=auto
# KIPRIS Plus REST accessKey (의견제출통지서·거절결정서·등록결정서·청구항 변동 이력 서비스)
KIPRIS_ACCESS_KEY=
# US mode stays implemented; true shows the 미국/한국 choice on the upload screen.
SHOW_US_MODE=false
# Specification evidence for AI review: retrieve (legacy) | elements (per claim element) | full (API models)
IMPROVEMENT_SPEC_MODE=elements
# v1 = original prompt, v2 = concrete SPEC-grounded limitation guidance
IMPROVEMENT_PROMPT=v2
IMPROVEMENT_CONTEXT_CHARS=200000
